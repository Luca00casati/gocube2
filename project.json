{
  // GoCube (see README.md): `c3c build`, `c3c test`, `c3c run` in this folder.
  "langrev": "1",
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**" ],
  "output": "build",
  // Strict floats (no fused multiply-add, no reordering): worlds generate the
  // same, bit for bit, on every machine and as they did before the port.
  "fp-math": "strict",
  "x86cpu": "sse4",
  // Optimised but still checked (bounds, nulls, contracts: a panic says
  // where): 4 to 8 times as fast as unoptimised; -O2 is barely faster and
  // drops the checks. (`c3c benchmark` measures it.)
  "opt": "O1",
  "targets": {
    "gocube": {
      "type": "executable"
    }
  }
}
